Algoritmo PromedioNotas
    Definir nota1, nota2, nota3, promedio Como Real
    
    Escribir "Por favor escriba nota 1: "
    Leer nota1
    
    Escribir "Por favor escriba nota 2: "
    Leer nota2
    
    Escribir "Por favor escriba nota 3: "
    Leer nota3

    promedio <- redon((nota1 + nota2 + nota3) / 3)

    Escribir "El promedio de tus notas es: ", promedio
    
FinAlgoritmo